  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "SIGAP-PARTNER-ACCESS-KEY-2026",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
