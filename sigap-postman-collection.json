        "body": {
          "mode": "raw",
          "raw": "{\n  \"faskesId\": \"faskes_1\",\n  \"obatId\": \"obat_1\",\n  \"status\": \"Ada\",\n  \"catatan\": \"Stok baru datang 20 botol tadi pagi\"\n}"
